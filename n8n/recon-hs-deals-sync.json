    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with c as (\n\tinsert into customers (crm_source, crm_id, name)\n\tvalues ('hubspot', $1::text, $2)\n\ton conflict (crm_source, crm_id) do update\n\t\tset name = excluded.name, updated_at = now()\n\treturning id\n)\ninsert into contracts (\n\tcustomer_id, crm_source, crm_id, name, crm_url, contract_start_date,\n\tfile_name, file_path, status\n)\nselect\n\tc.id, 'hubspot', $3::text, $4, $5,\n\tnullif(nullif($6::text, ''), 'null')::date,\n\tnullif(nullif($7::text, ''), 'null'),\n\tnullif(nullif($8::text, ''), 'null'),\n\t$9\nfrom c\non conflict (crm_source, crm_id) do update\n\tset name = excluded.name,\n\t\tcrm_url = excluded.crm_url,\n\t\tcontract_start_date = excluded.contract_start_date,\n\t\tfile_name = excluded.file_name,\n\t\tfile_path = excluded.file_path,\n\t\t-- A file that has not changed keeps whatever state the reading step left it in.\n\t\tstatus = case\n\t\t\twhen excluded.file_path is null then 'no_contract'\n\t\t\twhen contracts.file_path is distinct from excluded.file_path then 'attached'\n\t\t\telse contracts.status\n\t\tend,\n\t\tarchived_at = null,\n\t\tupdated_at = now()\nreturning crm_id, file_name, status;",
        "options": {
          "queryReplacement": "={{ $json.company_crm_id }},{{ $json.company_name }},{{ $json.deal_crm_id }},{{ $json.deal_name }},{{ $json.crm_url }},{{ $json.start_date }},{{ $json.file_name }},{{ $json.file_path }},{{ $json.status }}"
